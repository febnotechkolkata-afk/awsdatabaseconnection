# Source Control (Noisy stuff)
.git
.gitignore

# Dependencies (Heavy stuff - should be installed inside the container instead)
node_modules/
bower_components/
venv/
.venv/

# Build outputs and IDE configurations
dist/
build/
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

# Secrets and Environment Files (Secret stuff)
.env
.env.*
*.pem
core
**/.aws
**/.ssh

# Logs and runtime caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
__pycache__/
.pytest_cache/

# Ignore the docker file configurations themselves
Dockerfile
.dockerignore
